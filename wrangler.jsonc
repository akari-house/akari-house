{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "akari-house",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "upload_source_maps": true,
  "triggers": {
    "crons": ["0 3 * * *", "*/5 * * * *"],
  },
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://akari-house.spacematesxyz.workers.dev",
    "TURNSTILE_HOSTNAME": "akari-house.spacematesxyz.workers.dev",
  },
  "secrets": {
    "required": [
      "TURNSTILE_SITE_KEY",
      "TURNSTILE_SECRET_KEY",
      "RESEND_API_KEY",
      "MEMBERSHIP_FROM_EMAIL",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akari-house-db",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "akari-house-media",
    },
  ],
}
